<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug builds only (never staging or release). Lets heart-rate reading be tested end to end on
    an emulator, which has no watch writing into Health Connect: see DebugHeartRateWriter.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.health.WRITE_HEART_RATE" />

    <application>
        <!-- DUMP: only the adb shell holds it, so no other app on the phone can trigger writes. -->
        <receiver
            android:name="com.enil.logez.debug.DebugHeartRateWriter"
            android:exported="true"
            android:permission="android.permission.DUMP"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="com.enil.logez.debug.WRITE_HEART_RATE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
