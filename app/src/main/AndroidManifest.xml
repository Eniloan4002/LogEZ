<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        logEZ is local-only by construction, not by policy toggle: no INTERNET permission
        is ever requested. This explicit removal is manifest-merger insurance against a
        future dependency accidentally re-adding it (PHASE2_PLAN.md §9.1/§9.11).
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <!-- M4b (PHASE2_PLAN.md §9.2/§9.3/§9.4/§9.7): live-workout foreground service, its ongoing
         notification, and the rest-timer's bounded doze-insurance wake lock. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Solely for the pre-Q "Save image" path (WorkoutShareController.saveToPictures): on
         API 26–28 writing the summary PNG into the shared Pictures library still requires this
         legacy permission. API 29+ saves through scoped MediaStore inserts and requests nothing,
         hence the hard maxSdkVersion cap. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name=".LogEzApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LogEZ">

        <!-- Single-Activity Compose host (PHASE2_PLAN.md §2.1). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- §9.2: specialUse — shortService caps at ~3min (workouts run 30-120min+); health
             requires body-sensor permissions this app has no use for. -->
        <service
            android:name=".feature.workout.service.WorkoutSessionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="@string/notification_workout_fgs_subtype" />
        </service>

        <!-- Summary-card share (WorkoutShareController): grants the user's chosen ACTION_SEND
             target one-off read access to PNGs under cacheDir/shared_images/ — the only exposed
             path (see res/xml/file_paths.xml). Local-only posture unchanged: still no network
             permission; the image leaves the device only through that explicit user choice. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.enil.logez.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
