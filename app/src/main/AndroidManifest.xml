<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        M21 (2026-09-12, Owner directive, decisions.md same date): the app's long-standing
        "no INTERNET, ever" rule is narrowly reversed for online map tiles (MapTiler at first,
        OpenFreeMap since 2026-09-25), replacing
        the bundled offline Metro-Manila-only map — this is LogEZ's first real network access.
        Map tile/style requests are the only thing that ever leaves the device; GPS tracking,
        workouts, Health Connect reads, and everything else stay fully local, unaffected. See
        docs/APP_OVERVIEW.md §8 for the current, accurate privacy description — its older
        "no INTERNET permission" claim no longer holds and needed rewriting alongside this.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 2026-09-25 (Play-readiness audit): MapLibre's own manifest declares ACCESS_WIFI_STATE, but
         its code only reads ConnectivityManager, which ACCESS_NETWORK_STATE covers, and nothing in
         this app touches WifiManager. Play asks apps to request only what they use, so the merged
         copy is stripped rather than merely left out of this file. -->
    <uses-permission
        android:name="android.permission.ACCESS_WIFI_STATE"
        tools:node="remove" />

    <!-- M4b (PHASE2_PLAN.md §9.2/§9.3/§9.4/§9.7): live-workout foreground service, its ongoing
         notification, and the rest-timer's bounded doze-insurance wake lock. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- 2026-09-25 (Play-readiness audit, Owner decision): WorkoutSessionService moved from
         specialUse to the health type, which Android documents for exercise trackers. From
         API 34 a health-type service must also meet one runtime prerequisite. The app meets it
         with HIGH_SAMPLING_RATE_SENSORS, a normal install-time permission with no dialog, so a
         typed workout never depends on Health Connect or a body-sensor grant the user may refuse.
         The app does not sample sensors at a high rate; the declaration exists solely as that
         prerequisite. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- M21a: GPS-tracked walk/run (rev. 3 plan §0.1/§2). Foreground-only — no
         ACCESS_BACKGROUND_LOCATION anywhere; a location foreground-service tracking session is
         only ever started while the app is in the foreground, which keeps GPS updates flowing
         through a locked screen with no background grant needed (§2.2). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- M21e/M21g (Part B, wellness metrics): read-only, all-day steps + calories via Health
         Connect (local IPC to the Health Connect app, same no-INTERNET-risk shape as
         FusedLocationProvider, see decisions.md 2026-09-09). Read-only for now; WRITE_*
         permissions are a separate, optional later milestone (M21i) if ever pursued. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" />

    <!-- M21f: live BPM scorecard during a workout + a historical chart afterward. Unlike calories,
         HeartRateRecord's own values are plain Longs (confirmed via the same javap check), so this
         permission is safe to request now, no unresolved-accessor risk. -->
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />

    <!-- M22a: in-app CameraX capture screen for Body Measurements progress photos — no other
         camera use anywhere in this app, and the system camera app is never launched via intent.
         required="false": a camera-less device (e.g. some tablets) must not be filtered out of the
         Play Store listing over one optional feature — declaring the permission alone would
         otherwise imply a required android.hardware.camera feature. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Solely for the pre-Q "Save image" path (WorkoutShareController.saveToPictures): on
         API 26–28 writing the summary PNG into the shared Pictures library still requires this
         legacy permission. API 29+ saves through scoped MediaStore inserts and requests nothing,
         hence the hard maxSdkVersion cap. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- M21e: Android 11+ package-visibility rule, without which HealthConnectClient.getSdkStatus()
         cannot tell whether the Health Connect app is actually installed and silently reports it as
         unavailable even when it is. Package-name literal, not a permission; unrelated to network
         access either way. -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:name=".LogEzApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.LogEZ">

        <!-- Single-Activity Compose host (PHASE2_PLAN.md §2.1). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- M21: Health Connect's own permission screen refuses to show its grant checkboxes at
             all unless the requesting app declares an activity for its privacy-policy/rationale
             link — confirmed on-device (logcat: "PermissionsActivity: App should support rationale
             intent, finishing!") before this was added, which is exactly why "Connect" on the
             Profile wellness card looked like a dead button. Two separate declarations are both
             required per Android's own Health Connect integration guide: the pre-Android-14 action
             below, and the Android-14+ activity-alias further down (search ViewPermissionUsageActivity). -->
        <activity
            android:name=".feature.privacy.PrivacyPolicyActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- §9.2: the health type (was specialUse until 2026-09-25, see the permission block
             above). shortService caps at ~3min and workouts run 30-120min+. -->
        <service
            android:name=".feature.workout.service.WorkoutSessionService"
            android:exported="false"
            android:foregroundServiceType="health" />

        <!-- M21a: the purpose-built `location` FGS type, not `specialUse` — distinct from
             WorkoutSessionService above; this one's whole job is to hold the location permission
             grant for the FGS's duration. -->
        <service
            android:name=".feature.activity.service.ActivityTrackingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Summary-card share (WorkoutShareController): grants the user's chosen ACTION_SEND
             target one-off read access to PNGs under cacheDir/shared_images/ — the only exposed
             path (see res/xml/file_paths.xml). Local-only posture unchanged: still no network
             permission; the image leaves the device only through that explicit user choice. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.enil.logez.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- M21: the Android-14+ half of the Health Connect rationale requirement described above
             PrivacyPolicyActivity — a fixed-name alias Health Connect resolves directly by action
             and category, targeting the same activity as the pre-14 declaration. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".feature.privacy.PrivacyPolicyActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>


        <!-- M23b. exported="false" is correct: the system sends APPWIDGET_UPDATE with an explicit
             component. Verify on an API 26-28 image before shipping — some older third-party
             launchers historically broadcast the update themselves. -->
        <receiver
            android:name=".feature.widget.WeeklyProgressWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_weekly_progress_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/weekly_progress_widget_info" />
        </receiver>

        <receiver
            android:name=".feature.widget.TimeChangeReceiver"
            android:exported="false">
            <intent-filter>
                <!-- Note: ACTION_TIME_CHANGED's action string is TIME_SET, not TIME_CHANGED. -->
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- 2026-09-25 (Play-readiness audit): the calendar library declares Compose's ui-tooling
             at runtime scope, which merged an EXPORTED PreviewActivity into the release manifest.
             It exists only for Android Studio previews and must not be launchable by other apps
             on a shipped build; this app lists ui-tooling as debugImplementation only. -->
        <activity
            android:name="androidx.compose.ui.tooling.PreviewActivity"
            tools:node="remove" />

    </application>

</manifest>
