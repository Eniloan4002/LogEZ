<?xml version="1.0" encoding="utf-8"?>
<!--
    LogEZ brand mark (2026-09-25, Owner request for a premium icon; replaces the M0 "L" placeholder).
    A hexagonal specimen cell around a chamfered L, following BRAND_IDENTITY.md §9: NeonGreen on
    near-black, a lab-concept symbol rather than a barbell, one bold shape that survives every
    adaptive mask. Everything sits inside the 66dp safe circle. The top-lit gradient (#DDFF94 to
    #86D11A through NeonGreen #B6FF3C) gives the mark depth without a glow effect.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Scaled about the centre so the stroked hexagon, vertex plus half-stroke, stays inside
         the 66dp safe circle every launcher mask keeps (it touched the edge at full size). -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.86"
        android:scaleY="0.86">
        <path
            android:pathData="M54,20.5 L83,37.25 L83,70.75 L54,87.5 L25,70.75 L25,37.25 Z"
            android:strokeWidth="5"
            android:strokeLineJoin="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="54"
                    android:startY="18"
                    android:endX="54"
                    android:endY="90">
                    <item android:offset="0" android:color="#FFDDFF94" />
                    <item android:offset="0.45" android:color="#FFB6FF3C" />
                    <item android:offset="1" android:color="#FF86D11A" />
                </gradient>
            </aapt:attr>
        </path>
        <path android:pathData="M46,36 L53.5,36 L53.5,62.5 L68,62.5 L68,68.5 L63.5,73 L41.5,73 L41.5,40.5 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="54"
                    android:startY="36"
                    android:endX="54"
                    android:endY="73">
                    <item android:offset="0" android:color="#FFDDFF94" />
                    <item android:offset="0.45" android:color="#FFB6FF3C" />
                    <item android:offset="1" android:color="#FF86D11A" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
