# Copy this file to `keystore.properties` (gitignored — never commit it) to build a signed
# release bundle/APK. Not needed for debug builds or for running the test suite.
#
# You'll need your own release keystore for this — generate one with:
#   keytool -genkey -v -keystore keystore/your-app.jks -keyalg RSA -keysize 2048 -validity 10000 -alias your-alias
#
# Never share a real keystore file or its passwords outside your team's secure storage.

storeFile=keystore/your-app.jks
storePassword=changeme
keyAlias=your-alias
keyPassword=changeme
